@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="text-center py-5">
    <h1 class="display-6 text-danger">Something went wrong</h1>
    <p class="lead">We couldn't finish your request. Please try again in a moment.</p>

    @if (Model.ShowRequestId)
    {
        <p class="text-muted">
            If you contact support, give them this request id:
            <code>@Model.RequestId</code>
        </p>
    }

    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to home</a>
</div>
